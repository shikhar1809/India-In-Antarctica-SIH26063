# Studio copy generation, review, and Microsoft Clarity — all optional. The
# portal runs fully without any of these; each feature just falls back or
# stays disabled until its variable is set.

# Only needed for the dev harnesses under src/studio and src/review that
# call the portal's own dev-server proxy; production always talks to the
# deployed Cloud Function regardless of these.
# VITE_STUDIO_API=
# VITE_REVIEW_API=

# Microsoft Clarity project id, so Site Management's "View site heatmap"
# card can link to the real dashboard instead of explaining how to set one
# up. This must be the SAME id configured in apps/public-site/.env — that is
# the app that actually loads the tracking script (see its src/clarity.ts);
# the portal only needs the id to build the dashboard link.
VITE_CLARITY_PROJECT_ID=
