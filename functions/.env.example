# Copy to .env.local for local emulator runs. Never commit the real file —
# .gitignore already covers .env and .env.*
#
# Production does NOT read this file. There the key comes from Secret
# Manager, set once with:
#   firebase functions:secrets:set GEMINI_API_KEY
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
