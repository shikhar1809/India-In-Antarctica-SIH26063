# Copy to .env.local for local emulator runs. Never commit the real file —
# .gitignore already covers .env and .env.*
#
# Production does NOT read this file. There the key comes from Secret
# Manager, set once with:
#   firebase functions:secrets:set GEMINI_API_KEY
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Social publishing via Upload-Post (https://upload-post.com) — posts to the
# connected X, LinkedIn and Instagram accounts. Without it the dissemination
# queue still works: a publisher posts by hand and confirms with the permalink,
# which is the queue's designed default, not a degraded mode.
#   Production: firebase functions:secrets:set UPLOAD_POST_API_KEY
UPLOAD_POST_API_KEY=
# Which Upload-Post profile owns the connected accounts.
UPLOAD_POST_PROFILE=default
