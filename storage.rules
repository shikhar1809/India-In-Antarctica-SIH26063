rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Uploaded research files live under research/{uid}/{fileName} — public
    // read (the archive is meant to be browsable by anyone), but a user can
    // only write into their OWN uid-prefixed folder, and only up to 50 MB.
    match /research/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Screenshots attached to a pause-menu bug report — write-only (same
    // reasoning as the bugReports Firestore collection), images only, 8 MB
    // cap per file.
    match /bug-reports/{reportId}/{fileName} {
      allow write: if request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if false;
    }

    // Voice notes, photographs and attachments uploaded by a scientist for
    // a dispatch. The scientist writes to their own uid-prefixed path; any
    // signed-in user can read (publishers and admins need the URLs to
    // preview).
    //
    // `{allPaths=**}` rather than a single `{fileName}`: the field app puts
    // attachments in a `docs/` folder under the dispatch, and a rule that
    // matched exactly one segment silently refused every one of them — the
    // photographs went up and the documents came back 403, which is what a
    // scientist saw as "Storage refused the upload".
    match /dispatches/{uid}/{dispatchId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024;
    }

    // Photographs and films a site manager put on the public Gallery page
    // (portal: Site → Edit gallery). World-readable, because that is the
    // whole point of them; written only into the uploader's own folder, the
    // same shape as every other upload here. Firestore's publicSiteData rule
    // is what decides whose additions actually appear on the page.
    match /siteGallery/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 200 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
